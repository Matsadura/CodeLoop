# Optional overrides for docker-compose.yml (local development only).
# Copy to .env next to docker-compose.yml. The defaults are fine for a
# throwaway local database; never reuse them anywhere else.
MYSQL_ROOT_PASSWORD=dev-root-password
MYSQL_DATABASE=CODE_DB
MYSQL_USER=CODE_USER
MYSQL_PASSWORD=dev-password
MYSQL_HOST_PORT=3306
JWT_SECRET_KEY=dev-only-insecure-jwt-secret-change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CODE_RUNNER=judge0
PISTON_URL=http://piston:2000
JUDGE0_URL=http://judge0:2358
JUDGE0_AUTH_TOKEN=
VITE_API_BASE_URL=http://localhost:5000/api
CHOKIDAR_USEPOLLING=false
