# Variables for docker-compose.prod.yml. Copy to .env.production (ignored by
# git), replace every value, and pass it with --env-file.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=CODE_DB
MYSQL_USER=CODE_USER
MYSQL_PASSWORD=
JWT_SECRET_KEY=
# Same-origin through Nginx needs no CORS; list origins only for other frontends.
CORS_ORIGINS=
# judge0 (external JUDGE0_URL) or piston (deploy/docker-compose.vps.yml).
CODE_RUNNER=judge0
PISTON_URL=
JUDGE0_URL=https://judge0.example.com
JUDGE0_AUTH_TOKEN=
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=
WEB_PORT=8080
# Only for deploy/docker-compose.vps.yml (Caddy + Let's Encrypt):
DOMAIN=codeloop.example.com
