# Copy to client/.env (local dev) and adjust. Vite only exposes VITE_* variables,
# and they are baked into the bundle at build time: never put secrets here.

# Display name used in the UI.
VITE_APP_NAME=codeLoop

# Base URL of the Flask API, including the /api prefix.
#   Local dev (Vite on :3000, Flask on :5000): http://localhost:5000/api
#   Production behind the bundled Nginx proxy:  /api
#   Production with a separately hosted API:   https://api.example.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Avatar used when a user has not set a profile picture.
VITE_DEFAULT_AVATAR=https://api.dicebear.com/9.x/identicon/svg?seed=codeloop
