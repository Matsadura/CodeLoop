# Rendered by the nginx image entrypoint (envsubst) at container start.
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 1m;

    # Behind a reverse proxy (Caddy, a PaaS router) use the client address it
    # reports, so rate limits apply per visitor. Only private ranges are trusted.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Slow down credential stuffing on the auth endpoints.
    location ~ ^/api/(login|register)$ {
        limit_req zone=auth burst=5 nodelay;
        limit_req_status 429;
        proxy_pass ${API_UPSTREAM};
        include /etc/nginx/conf.d/proxy_params.inc;
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        include /etc/nginx/conf.d/proxy_params.inc;
    }

    # Fingerprinted build assets can be cached forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Client-side routes fall back to the SPA entry point.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
