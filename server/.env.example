# Copy to server/.env for running the API outside Docker (python -m api.app).
# Every variable can also be set in the real environment instead.

# development | production | testing. Defaults to production (strict checks).
APP_ENV=development

# --- Database: either DATABASE_URL or the CODE_DB_* parts ---------------
# DATABASE_URL=mysql+pymysql://CODE_USER:change-me@127.0.0.1:3306/CODE_DB?charset=utf8mb4
CODE_DB_HOST=127.0.0.1
CODE_DB_PORT=3306
CODE_DB_USER=CODE_USER
CODE_DB_PASSWORD=change-me
CODE_DB_NAME=CODE_DB

# --- Auth -----------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Comma-separated origins allowed to call the API from a browser.
# Defaults to http://localhost:3000,http://127.0.0.1:3000 in development.
CORS_ORIGINS=http://localhost:3000

# --- Judge0 ---------------------------------------------------------------
JUDGE0_URL=http://localhost:2358
# Self-hosted Judge0 with AUTHN_TOKEN set in judge0.conf:
# JUDGE0_AUTH_TOKEN=
# Hosted Judge0 CE on RapidAPI (JUDGE0_URL=https://judge0-ce.p.rapidapi.com):
# JUDGE0_RAPIDAPI_KEY=
# JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
JUDGE0_REQUEST_TIMEOUT=10
JUDGE0_MAX_RETRIES=2
JUDGE0_SYNC_WAIT=15
JUDGE0_POLL_INTERVAL=1
JUDGE0_LANGUAGE_IDS=python=71,c=50

# Dev server bind address (python -m api.app only)
CODE_API_HOST=0.0.0.0
CODE_API_PORT=5000
LOG_LEVEL=INFO
